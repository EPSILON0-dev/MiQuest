{
  "$defs": {
    "CreateProject": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "description": {
          "default": "",
          "maxLength": 100000,
          "title": "Description",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "title": "CreateProject",
      "type": "object"
    },
    "ImportDependency": {
      "additionalProperties": false,
      "properties": {
        "quest": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Quest",
          "type": "string"
        },
        "dependsOn": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Dependson",
          "type": "string"
        }
      },
      "required": [
        "quest",
        "dependsOn"
      ],
      "title": "ImportDependency",
      "type": "object"
    },
    "ImportPage": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Key",
          "type": "string"
        },
        "name": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "quests": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "title": "Quests",
          "type": "array"
        }
      },
      "required": [
        "key",
        "name",
        "quests"
      ],
      "title": "ImportPage",
      "type": "object"
    },
    "ImportQuest": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Key",
          "type": "string"
        },
        "title": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "homePage": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Homepage",
          "type": "string"
        },
        "description": {
          "default": "",
          "maxLength": 100000,
          "title": "Description",
          "type": "string"
        },
        "acceptanceCriteria": {
          "default": "",
          "maxLength": 100000,
          "title": "Acceptancecriteria",
          "type": "string"
        },
        "iconName": {
          "default": "compass",
          "enum": [
            "book-open",
            "box",
            "check-circle",
            "compass",
            "flag",
            "globe",
            "home",
            "layers",
            "lightbulb",
            "message-circle",
            "palette",
            "pen-tool",
            "rocket",
            "search",
            "send",
            "sparkles",
            "sun",
            "users"
          ],
          "title": "Iconname",
          "type": "string"
        },
        "milestone": {
          "default": false,
          "title": "Milestone",
          "type": "boolean"
        }
      },
      "required": [
        "key",
        "title",
        "homePage"
      ],
      "title": "ImportQuest",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1,
      "title": "Version",
      "type": "integer"
    },
    "project": {
      "$ref": "#/$defs/CreateProject"
    },
    "pages": {
      "items": {
        "$ref": "#/$defs/ImportPage"
      },
      "minItems": 1,
      "title": "Pages",
      "type": "array"
    },
    "quests": {
      "items": {
        "$ref": "#/$defs/ImportQuest"
      },
      "title": "Quests",
      "type": "array"
    },
    "dependencies": {
      "items": {
        "$ref": "#/$defs/ImportDependency"
      },
      "title": "Dependencies",
      "type": "array"
    },
    "pins": {
      "items": {
        "maxLength": 200,
        "minLength": 1,
        "type": "string"
      },
      "title": "Pins",
      "type": "array"
    }
  },
  "required": [
    "version",
    "project",
    "pages",
    "quests"
  ],
  "title": "ImportDocument",
  "type": "object"
}
